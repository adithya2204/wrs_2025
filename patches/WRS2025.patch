-choreonoid_add_simple_controller(MonoCrawlerJoystickController MonoCrawlerJoystickController.cpp)
+# Find the required build system and ROS2 packages
+find_package(ament_cmake REQUIRED)
+find_package(rclcpp REQUIRED)
+find_package(sensor_msgs REQUIRED)
+find_package(std_msgs REQUIRED)
+
+# --- Your Controllers ---
+
+# WRS_AizuController with ROS2 support
+# NOTE: Target renamed to AizuController to avoid conflicts
+choreonoid_add_simple_controller(AizuController AizuSpiderController.cpp)
+set_target_properties(AizuController PROPERTIES
+  CXX_STANDARD 17
+  CXX_STANDARD_REQUIRED YES
+)
+ament_target_dependencies(AizuController
+  rclcpp
+  sensor_msgs
+  std_msgs
+)
+
+# WRS_HobbyDroneController with ROS2 support
+# NOTE: Target renamed to HobbyDroneController to avoid conflicts
+
+choreonoid_add_simple_controller(HobbyDroneController HobbyDroneJoystickController.cpp)
+set_target_properties(HobbyDroneController PROPERTIES
+  CXX_STANDARD 17
+  CXX_STANDARD_REQUIRED YES
+)
+# CRITICAL: Define ROS2_ENABLED to compile with ROS2 support
+target_compile_definitions(HobbyDroneController PRIVATE ROS2_ENABLED)
+# FIX: Add CnoidCFDPlugin for Rotor class support
+target_link_libraries(HobbyDroneController CnoidCFDPlugin)
+ament_target_dependencies(HobbyDroneController
+  rclcpp
+  sensor_msgs
+)
+
+# WRS_HobbyDroneController1 with ROS2 support (ROS2 Only - no fallback)
+choreonoid_add_simple_controller(HobbyDroneController1 HobbyDroneJoystickController1.cpp)
+set_target_properties(HobbyDroneController1 PROPERTIES
+  CXX_STANDARD 17
+  CXX_STANDARD_REQUIRED YES
+)
+# Link CnoidCFDPlugin for Rotor class support
+target_link_libraries(HobbyDroneController1 CnoidCFDPlugin)
+# ROS2 dependencies
+ament_target_dependencies(HobbyDroneController1
+  rclcpp
+  sensor_msgs
+)
+
+# --- Other Controllers (No ROS2 dependencies) ---
+
+choreonoid_add_simple_controller(BreakerBoxController BreakerBoxController.cpp)
 
 choreonoid_add_simple_controller(LeakedLineController LeakedLineController.cpp)
 target_link_libraries(LeakedLineController CnoidSceneEffectsPlugin)
 
