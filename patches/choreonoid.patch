+bool AizuSpiderController::initialize(SimpleControllerIO* io)
+{
+    body = io->body();
+    dt = io->timeStep();
+    mainActuationMode = Link::JointTorque;
+    for(const auto& opt : io->options()){
+        if(opt == "velocity"){ mainActuationMode = Link::JointVelocity;
+        } else if(opt == "position"){ mainActuationMode = Link::JointDisplacement;
+        } else if(opt == "effort" || opt == "torque"){ mainActuationMode = Link::JointTorque;
+        } else if(opt == "ps4"){ use_xbox_mapping = false; }
+    }
+    io->os() << format("AizuSpiderController: actuation mode = {0}\n", mainActuationMode);
+    if(!initializeTracks(io)) return false;
+    if(!initializeFlipperJoints(io)) return false;
+    initializeROS(true);
     joystick = io->getOrCreateSharedObject<SharedJoystick>("joystick");
     targetMode = joystick->addMode();
-
     return true;
 }
 
+bool AizuSpiderController::control()
+{
+    if(!is_active_){
+        return true;
+    }
+
+    if(joystick) joystick->updateState(targetMode);
+    controlTracks();
+    updateFlipperTargetPositions();
+    if(mainActuationMode == Link::JointTorque){ controlJointsWithTorque(); }
+    else if(mainActuationMode == Link::JointVelocity){ controlJointsWithVelocity(); }
+    else if(mainActuationMode == Link::JointDisplacement){ controlJointsWithPosition(); }
+    return true;
+}
 
