+void AizuSpiderController::initializeROS(bool prefer_ros_joy)
+{
+    use_ros_joy = false;
+    try {
+        if(!rclcpp::ok()) { rclcpp::init(0, nullptr); }
+        node = rclcpp::Node::make_shared("aizu_spider_controller");
+        joy_sub = node->create_subscription<sensor_msgs::msg::Joy>(
+            "/joy", 10,
+            std::bind(&AizuSpiderController::joyCallback, this, std::placeholders::_1)
+        );
+
+        controller_sub_ = node->create_subscription<std_msgs::msg::String>(
+            "/active_controller", 10,
+            [this](const std_msgs::msg::String::SharedPtr msg){
+                if(msg->data == "choreonoid"){
+                    if (!this->is_active_) RCLCPP_INFO(this->node->get_logger(), "==> Choreonoid Base/Flipper Control Activated <==");
+                    this->is_active_ = true;
+                } else {
+                    if (this->is_active_) RCLCPP_INFO(this->node->get_logger(), "==> Choreonoid Base/Flipper Control Deactivated <==");
+                    this->is_active_ = false;
+                }
+            }
+        );
+
+        executor = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
+        executor->add_node(node);
+        stop_ros_thread = false;
+        ros_thread = thread(&AizuSpiderController::rosSpinThread, this);
+        use_ros_joy = true;
+        use_xbox_mapping = true;
+    } catch(const std::exception& ex){
+        use_ros_joy = false; node.reset(); joy_sub.reset(); executor.reset();
