+AizuSpiderController::~AizuSpiderController()
+{
+    stop_ros_thread = true;
+    if(executor){ try { executor->cancel(); } catch(...){} }
+    if(ros_thread.joinable()){ ros_thread.join(); }
+    // Clean up node and subscriptions after the spin thread has stopped.
+    joy_sub.reset();
+    controller_sub_.reset();
+    if(executor && node){
+        try { executor->remove_node(node); } catch(...) {}
+    }
+    executor.reset();
+    node.reset();
+    // NOTE: rclcpp::shutdown() is intentionally NOT called here.
+    // This controller shares the global RCL context with ROS2ControlItem,
+    // BodyROS2Item, and WorldROS2Item. Calling shutdown() here invalidates
+    // the context for all other nodes, causing the controller_manager
+    // destructor to crash with "rcl node's context is invalid".
+    // The OS reclaims all RCL resources when the process exits.
+}
 
