items:
  id: 0
  name: "RootItem"
  plugin: Base
  class: RootItem
  is_builtin_item: true
  children:
    -
      id: 1
      name: "World"
      plugin: Body
      class: WorldItem
      is_checked: true
      data:
        collision_detection: false
        collision_detector: AISTCollisionDetector
        default_material_table_file: "${SHARE}/default/materials.yaml"
      children:
        -
          id: 2
          name: "AISTSimulator"
          plugin: Body
          class: AISTSimulatorItem
          is_checked: true
          data:
            time_step: 0.001
            realtime_sync_mode: compensatory
            recording: off
            time_range_mode: unlimited
            time_length: 300
            is_active_control_time_range_mode: false
            output_all_link_positions: false
            output_device_states: true
            use_controller_threads: true
            record_collision_data: false
            controller_options: ""
            block_scene_view_edit_mode: false
            dynamicsMode: "Forward dynamics"
            integrationMode: semi-implicit_euler
            gravity: [ 0, 0, -9.80665 ]
            min_friction_coefficient: 0
            max_friction_coefficient: 3
            cullingThresh: 0.015
            contactCullingDepth: 0.05
            errorCriterion: 0.005
            maxNumIterations: 20
            contactCorrectionDepth: 0.00025
            contactCorrectionVelocityRatio: 5
            kinematicWalking: false
            2Dmode: false
            oldAccelSensorMode: false
          children:
            -
              id: 3
              name: "GLVisionSimulator"
              plugin: GLVisionSimulator
              class: GLVisionSimulatorItem
              is_checked: true
              data:
                enabled: true
                max_frame_rate: 30
                max_latency: 1
                record_vision_data: false
                thread_mode: Single
                best_effort: false
                all_scene_objects: true
                range_sensor_precision_ratio: 2
                depth_error: 0
                background_color: [ 0, 0, 0 ]
                enable_head_light: true
                enable_world_light: true
                enable_additional_lights: true
                antialiasing: false
            -
              id: 4
              name: "CFDSimulator"
              plugin: CFD
              class: CFDSimulatorItem
              is_checked: true
              data:
                enabled: true
        -
          id: 5
          name: "AizuSpider"
          plugin: Body
          class: BodyItem
          is_checked: true
          data:
            file: "${SHARE}/model/AizuSpider/AizuSpiderDS.body"
            format: CHOREONOID-BODY
            currentBaseLink: "CHASSIS"
            rootPosition: [ -3.99997784, -0.750003768, 0.0448017425 ]
            rootAttitude: [
              0.999999978, 5.32828669e-05, 0.000205262493,
              -5.3283886e-05, 0.999999999, 4.9596109e-06,
              -0.000205262229, -4.97054797e-06, 0.999999979 ]
            jointDisplacements: [
              0, 0, 0, 0, -90, 150.989, 26.6709, -92.9826, 5.99249, 99.9976,
              0.00689359, 0.00992724, 0.00720251, -89.9902, 151.191, 27.3102, -93.0118, 5.99102, 100.002, 0.0129752,
              0.00905648, 0.0108243, 0, 0, 0, 0, 0, 0 ]
            initialJointDisplacements: [
              0, 0, 0, 0, -90, 151, 27, -93, 6.00001, 100,
              0, 0, 0, -90, 151, 27, -93, 6.00001, 100, 0,
              0, 0, 0, 0, 0, 0, 0, 0 ]
            initialRootPosition: [ -4, -0.75, 0.045 ]
            initialRootAttitude: [
              1, 0, 0,
              0, 1, 0,
              0, 0, 1 ]
            fix_root: false
            collisionDetection: true
            selfCollisionDetection: false
            lock_location: false
            scene_sensitive: true
            link_kinematics:
              "ARM1_HAND":
                base_frame: 0
                offset_frame: 0
          children:
            -
              id: 6
              name: "AizuSpiderController"
              plugin: Body
              class: SimpleControllerItem
              is_checked: true
              data:
                isNoDelayMode: false
                controllerOptions: "position"
                controller: "AizuSpiderController"
                base_directory: "Controller directory"
                reloading: true
                export_symbols: false
            -
              id: 7
              name: "BodyROS2"
              plugin: ROS2
              class: BodyROS2Item
              is_checked: true
              data:
                body_ros_version: 0
                joint_state_update_rate: 100
            -
              id: 8
              name: "ROS2Control"
              plugin: ROS2
              class: ROS2ControlItem
              is_checked: true
        -
          id: 9
          name: "M3"
          plugin: Base
          class: SubProjectItem
          is_checked: true
          data:
            file: "../M3/M3.cnoid"
            format: PROJECT
            save_mode: "Manual save"
        -
          id: 84
          name: "WorldROS2"
          plugin: ROS2
          class: WorldROS2Item
          is_checked: true
          data:
            max_clock_publishing_rate: 100
        -
          id: 85
          name: "PrasidDrone"
          plugin: Base
          class: SubProjectItem
          is_checked: true
          data:
            file: "PrasidDrone.cnoid"
            format: PROJECT
            save_mode: "Manual save"
        -
          id: 89
          name: "CFDCollider"
          plugin: SimpleCollider
          class: MultiColliderItem
          is_checked: true
          data:
            translation: [ 0, 0, 0 ]
            rotation: [ 0, -0, 0 ]
            size: [ 30, 30, 30 ]
            diffuse_color: [ 0, 1, 1 ]
            radius: 0.5
            height: 1
            specular_exponent: 25
            transparency: 1
            scene_type: Box
            collider_type: CFD
            density: 0
            viscosity: 0
            steady_flow: [ 0, 0, 0 ]
            inbound_delay: 0
            inbound_rate: 0
            inbound_loss: 0
            outbound_delay: 0
            outbound_rate: 0
            outbound_loss: 0
            source: 0.0.0.0/0
            destination: 0.0.0.0/0
            hsv: [ 0, 0, 0 ]
            rgb: [ 0, 0, 0 ]
            coef_b: 0
            coef_d: 0
            std_dev: 0
            salt_amount: 0
            salt_chance: 0
            pepper_amount: 0
            pepper_chance: 0
            mosaic_chance: 0
            kernel: 16
views:
  -
    id: 0
    plugin: Base
    class: GeneralSliderView
  -
    id: 1
    plugin: Base
    class: ItemPropertyView
    mounted: true
  -
    id: 2
    plugin: Base
    class: ItemTreeView
    mounted: true
    state:
      expanded: [ 2, 5, 6, 9, 85 ]
  -
    id: 3
    plugin: Base
    class: LocationView
    mounted: true
    state:
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      coordinate: world
  -
    id: 4
    plugin: Base
    class: MessageView
    mounted: true
  -
    id: 5
    plugin: Base
    class: SceneView
    mounted: true
    state:
      operation_mode: view
      viewpoint_operation_mode: third_person
      focus_position: [ -4.36383, -1.92023, 0.00743871 ]
      visible_polygon_elements: [ face ]
      highlighting: false
      collision_lines: false
      cameras:
        -
          camera: [ System, Perspective ]
          is_current: true
          eye: [ -5.5285, 3.28014, 2.15552 ]
          direction: [ 0.333784, -0.879163, -0.34009 ]
          up: [ 0.120712, -0.317947, 0.940393 ]
        -
          camera: [ System, Orthographic ]
          ortho_height: 20
      lighting_mode: normal
      culling_mode: enabled
      shading_mode: smooth
      world_light: true
      world_light_intensity: 0.5
      ambient_light: true
      ambient_light_intensity: 0.5
      head_light: true
      head_light_intensity: 0.5
      world_light_shadow: true
      shadow_lights:
        - { index: 0, enabled: false }
        - { index: 1, enabled: false }
      background_color: [ 0.1, 0.1, 0.3 ]
      line_width: 1
      point_size: 1
      field_of_view: 35
      clip_distances: [ 0.04, 200 ]
      floorGrid: true
      floorGridSpan: 10
      floorGridInterval: 0.5
      xzGrid: false
      xzGridSpan: 10
      xzGridInterval: 0.5
      yzGrid: false
      yzGridSpan: 10
      yzGridInterval: 0.5
      xy_grid_color: [ 0.9, 0.9, 0.9 ]
      xz_grid_color: [ 0.9, 0.9, 0.9 ]
      yz_grid_color: [ 0.9, 0.9, 0.9 ]
  -
    id: 6
    plugin: Body
    class: JointDisplacementView
    mounted: true
    state:
      show_joint_ids: true
      show_joint_names: false
      overlap_joint_names: false
      show_sliders: true
      show_dials: false
      show_phases: true
      limit_ranges: false
      show_selected_joints: false
  -
    id: 7
    plugin: Body
    class: LinkDeviceListView
    mounted: true
    state:
      element_type: all
      listing_mode: list
      body_items:
        -
          id: 5
          selected_links: [ 0 ]
        -
          id: 10
          selected_links: [ 0 ]
  -
    id: 8
    plugin: Body
    class: LinkPositionView
    mounted: true
    state:
      coordinate_mode: world
      preferred_coordinate_mode: base
      show_rpy: true
      unique_rpy: false
      show_quaternion: false
      show_rotation_matrix: false
      target_link_type: ik_link
  -
    id: 9
    plugin: Body
    class: LinkPropertyView
    mounted: true
  -
    id: 10
    plugin: Python
    class: PythonConsoleView
    mounted: true
toolbars:
  "TimeBar":
    current_time: 0
    min_time: 0
    max_time: 30
    frame_rate: 1000
    playback_frame_rate: 60
    idle_loop_driven_mode: false
    playback_speed_ratio: 1
    sync_to_ongoing_updates: true
    auto_expansion: true
  "LeggedBodyBar":
    stanceWidth: 0.15
  "KinematicsBar":
    forward_kinematics: true
    inverse_kinematics: true
    preset_kinematics: true
    enablePositionDragger: true
    penetrationBlock: false
    collisionLinkHighlight: false
    snapDistance: 0.025
    penetrationBlockDepth: 0.0005
    lazyCollisionDetectionMode: true
Body:
  "BodySelectionManager":
    current_body_item: 10
    current_link: "Floor"
  "KinematicFaultChecker":
    checkJointPositions: true
    angleMargin: 0
