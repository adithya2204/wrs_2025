<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="AizuSpiderDA_ros2_control" params="name initial_positions_file">
        <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>choreonoid_ros2_control/SystemInterfaceCnoid</plugin>
            </hardware>
            <joint name="ARM1_SHOULDER">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_SHOULDER']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_ARM">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_ARM']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_FOREARM">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_FOREARM']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_WRIST1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_WRIST1']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_WRIST2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_WRIST2']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_HAND">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_HAND']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_SHOULDER">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_SHOULDER']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_ARM">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_ARM']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_FOREARM">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_FOREARM']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_WRIST1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_WRIST1']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_WRIST2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_WRIST2']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_HAND">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_HAND']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_FINGER1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_FINGER1']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_FINGER2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_FINGER2']}</param>
                </state_interface>
            </joint>
            <joint name="ARM1_FINGER3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM1_FINGER3']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_FINGER1">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_FINGER1']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_FINGER2">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_FINGER2']}</param>
                </state_interface>
            </joint>
            <joint name="ARM2_FINGER3">
                <command_interface name="position"/>
                <state_interface name="position">
                  <param name="initial_value">${initial_positions['ARM2_FINGER3']}</param>
                </state_interface>
            </joint>
        </ros2_control>
    </xacro:macro>
</robot>