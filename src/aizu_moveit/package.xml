<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aizu_moveit</name>
  <version>0.3.0</version>

  <description>
    MoveIt2 configuration package for the AizuSpider disaster-response robot,
    including planning configuration, controllers, and teleoperation utilities.
  </description>

  <maintainer email="adithyapothula123@gmail.com">Adithya Pothula</maintainer>
  <author email="adithyapothula123@gmail.com">Adithya Pothula</author>

  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot description -->
  <exec_depend>aizu_spider_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- MoveIt -->
  <exec_depend>moveit_ros_planning</exec_depend>
  <exec_depend>moveit_ros_planning_interface</exec_depend>
  <exec_depend>moveit_servo</exec_depend>
  <exec_depend>moveit_ros_visualization</exec_depend>

  <!-- Controllers & ROS -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>joy</exec_depend>

  <!-- Visualization -->
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>