<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="aizu_spider_base">


  <!-- ================================================================= -->
  <!-- |                     COMPONENT MACROS                          | -->
  <!-- ================================================================= -->

  <xacro:macro name="main_roller" params="name parent *origin">
    <link name="${name}">
      <inertial>
        <mass value="0.08293"/>
        <inertia ixx="0.000034" ixy="0" ixz="0" iyy="0.000006" iyz="0" izz="0.000034"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.067" radius="0.012125"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.067" radius="0.012125"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="sub_roller" params="name parent *origin">
    <link name="${name}">
      <inertial>
        <mass value="0.11668"/>
        <inertia ixx="0.0000349" ixy="0" ixz="0" iyy="0.0000152" iyz="0" izz="0.0000349"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.053" radius="0.01617"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.053" radius="0.01617"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="flipper_assembly" params="prefix parent joint_axis_y x_multiplier belt_rotation flipper_visual_rpy *origin">
    <link name="${prefix}_FLIPPER">
      <inertial>
        <mass value="0.71405"/>
        <origin rpy="0 0 0" xyz="0 0.00756 0.14824"/>
        <inertia ixx="0.0071" ixy="0" ixz="0" iyy="0.0073" iyz="-0.00019" izz="0.00092"/>
      </inertial>
      <visual>
        <origin rpy="${flipper_visual_rpy}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/FLIPPER.stl"/>
        </geometry>
        <material name="RED"/>
      </visual>
      <collision>
        <origin rpy="${flipper_visual_rpy}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/FLIPPER.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_FLIPPER" type="revolute">
      <parent link="${parent}"/>
      <child link="${prefix}_FLIPPER"/>
      <xacro:insert_block name="origin"/>
      <axis xyz="0 ${joint_axis_y} 0"/>
      <limit effort="200" lower="-2.09" upper="2.09" velocity="2.0"/>
    </joint>

    <link name="${prefix}_SUB_TRACK_WHEEL1">
      <inertial>
        <mass value="2.23528"/>
        <inertia ixx="0.00367" ixy="0" ixz="0" iyy="0.00659" iyz="0" izz="0.00367"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_SUB_TRACK_WHEEL1" type="continuous">
      <parent link="${prefix}_FLIPPER"/>
      <child link="${prefix}_SUB_TRACK_WHEEL1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_SUB_TRACK_WHEEL2">
      <inertial>
        <mass value="0.49044"/>
        <!-- FIX: Corrected inertia tensor values to be physically realistic for a cylinder. -->
        <!-- The original ixx value (0.00241) violated the triangle inequality, making it unrealistic. -->
        <!-- The values have been recalculated based on the cylinder's geometry and mass. -->
        <inertia ixx="0.000241" ixy="0" ixz="0" iyy="0.000325" iyz="0" izz="0.000241"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.036385"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.036385"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_SUB_TRACK_WHEEL2" type="continuous">
      <parent link="${prefix}_FLIPPER"/>
      <child link="${prefix}_SUB_TRACK_WHEEL2"/>
      <origin rpy="0 0 0" xyz="${0.29450 * x_multiplier} 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_SUB_TRACK_BOTTOM_GUIDE">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <collision>
        <origin rpy="0 -0.1364 0" xyz="0 0 0.00383"/>
        <geometry>
          <box size="0.14 0.053 0.04"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_SUB_TRACK_BOTTOM_GUIDE" type="fixed">
      <parent link="${prefix}_FLIPPER"/>
      <child link="${prefix}_SUB_TRACK_BOTTOM_GUIDE"/>
      <origin rpy="0 0 0" xyz="${0.15 * x_multiplier} 0 -0.043936"/>
    </joint>
    
    <xacro:sub_roller name="${prefix}_SUB_ROLLER_1" parent="${prefix}_FLIPPER"><origin rpy="0 0 0" xyz="${0.080 * x_multiplier} 0 -0.05363"/></xacro:sub_roller>
    <xacro:sub_roller name="${prefix}_SUB_ROLLER_2" parent="${prefix}_FLIPPER"><origin rpy="0 0 0" xyz="${0.115 * x_multiplier} 0 -0.04833"/></xacro:sub_roller>
    <xacro:sub_roller name="${prefix}_SUB_ROLLER_3" parent="${prefix}_FLIPPER"><origin rpy="0 0 0" xyz="${0.150 * x_multiplier} 0 -0.04404"/></xacro:sub_roller>
    <xacro:sub_roller name="${prefix}_SUB_ROLLER_4" parent="${prefix}_FLIPPER"><origin rpy="0 0 0" xyz="${0.185 * x_multiplier} 0 -0.03924"/></xacro:sub_roller>
    <xacro:sub_roller name="${prefix}_SUB_ROLLER_5" parent="${prefix}_FLIPPER"><origin rpy="0 0 0" xyz="${0.220 * x_multiplier} 0 -0.03444"/></xacro:sub_roller>

    <link name="${prefix}_SUB_BELT_visual">
      <visual>
        <origin rpy="-1.5708 0 ${belt_rotation}" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/SUB_BELT.stl"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
    </link>
    <joint name="${prefix}_SUB_BELT_visual_joint" type="fixed">
      <parent link="${prefix}_FLIPPER"/>
      <child link="${prefix}_SUB_BELT_visual"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="camera_mount" params="prefix parent *origin">
    <link name="${prefix}_CAMERA">
      <inertial>
        <mass value="0.02199"/>
        <origin rpy="0 0 0" xyz="-0.00003 0.00640 0.00007"/>
        <inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000009" iyz="0" izz="0.000007"/>
      </inertial>
      <visual>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/MCM-4350FISH.stl"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/MCM-4350FISH.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${prefix}_CAMERA" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_CAMERA"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="wire_guard" params="name parent size *origin">
    <link name="${name}">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <collision>
        <geometry>
          <box size="${size}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================= -->
  <!-- |                  AIZU SPIDER BASE MACRO                       | -->
  <!-- ================================================================= -->
  <xacro:macro name="aizu_spider_base" params="parent_link origin_xyz origin_rpy">
    
    <!-- CHASSIS LINK AND JOINT -->
    <link name="CHASSIS_BODY">
      <inertial>
        <origin rpy="0 0 0" xyz="-0.08192 0 0.15046"/>
        <mass value="47.91109"/>
        <inertia ixx="1.1550" ixy="0" ixz="-0.2151" iyy="2.1375" iyz="0" izz="1.9466"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/CHASSIS.stl"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/CHASSIS.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="CHASSIS_BODY" type="fixed">
      <parent link="${parent_link}"/>
      <child link="CHASSIS_BODY"/>
      <origin rpy="${origin_rpy}" xyz="${origin_xyz}"/>
    </joint>

    <!-- SENSORS, LIGHTS, AND MOUNTING FRAMES -->
    <link name="CompetitorMarker">
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
        <material name="RED"/>
      </visual>
    </link>
    <joint name="CompetitorMarker" type="fixed">
      <parent link="CHASSIS"/>
      <child link="CompetitorMarker"/>
      <origin rpy="0 0 0" xyz="-0.06 0 0.45"/>
    </joint>

    <link name="CHASSIS_ACCELERATION_SENSOR"/>
    <joint name="CHASSIS_ACCELERATION_SENSOR" type="fixed">
      <parent link="CHASSIS"/>
      <child link="CHASSIS_ACCELERATION_SENSOR"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="CHASSIS_RATE_GYRO_SENSOR"/>
    <joint name="CHASSIS_RATE_GYRO_SENSOR" type="fixed">
      <parent link="CHASSIS"/>
      <child link="CHASSIS_RATE_GYRO_SENSOR"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="LRF">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0.05544 0.09464"/>
        <mass value="5.29071"/>
        <inertia ixx="0.19949" iyy="0.57864" izz="0.37969" ixy="0.0" ixz="0.0" iyz="0.00041"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.03"/>
        <geometry>
          <box size="0.060 0.087 0.060"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.03"/>
        <geometry>
          <box size="0.060 0.087 0.060"/>
        </geometry>
      </collision>
    </link>
    <joint name="LRF" type="fixed">
      <parent link="CHASSIS"/>
      <child link="LRF"/>
      <origin rpy="1.5708 0 -1.5708" xyz="0.23415 0 0.19750"/>
    </joint>

    <link name="FRONT_LIGHT">
     <inertial>
        <origin rpy="0 0 0" xyz="0 0.00699 -0.00069"/>
        <mass value="0.00448"/>
        <inertia ixx="0.00000027508" ixy="0" ixz="0" iyy="0.00000034236" iyz="0.00000001327" izz="0.00000030936"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/LEDJ1-W.stl"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://aizu_spider_description/meshes/LEDJ1-W.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="FRONT_LIGHT" type="fixed">
      <parent link="CHASSIS"/>
      <child link="FRONT_LIGHT"/>
      <origin rpy="1.5708 0 -1.5708" xyz="0.12580 0 0.41050"/>
    </joint>

    <link name="VERTICAL_ARM_FRAME">
      <inertial>
        <mass value="0.42880"/>
        <inertia ixx="0.00041" ixy="0" ixz="0" iyy="0.00011" iyz="0" izz="0.00041"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.05"/>
        <geometry>
          <box size="0.04 0.04 0.1"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.05"/>
        <geometry>
          <box size="0.04 0.04 0.1"/>
        </geometry>
      </collision>
    </link>
    <joint name="VERTICAL_ARM_FRAME" type="fixed">
      <parent link="CHASSIS"/>
      <child link="VERTICAL_ARM_FRAME"/>
      <origin rpy="0 0 0" xyz="-0.060 0.094 0.43050"/>
    </joint>

    <link name="HORIZONTAL_ARM_FRAME">
      <inertial>
        <mass value="1.13632"/>
        <inertia ixx="0.00094" ixy="0" ixz="0.00033" iyy="0.00485" iyz="0" izz="0.00421"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="-0.0808 0 0.05875"/>
        <geometry>
          <box size="0.200 0.040 0.085"/>
        </geometry>
        <material name="DARK_GRAY"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="-0.0808 0 0.05875"/>
        <geometry>
          <box size="0.200 0.040 0.085"/>
        </geometry>
      </collision>
    </link>
    <joint name="HORIZONTAL_ARM_FRAME" type="fixed">
      <parent link="CHASSIS"/>
      <child link="HORIZONTAL_ARM_FRAME"/>
      <origin rpy="0 0 0" xyz="-0.06320 -0.094 0.43050"/>
    </joint>
    
    <xacro:camera_mount prefix="FRONT" parent="CHASSIS"><origin rpy="1.5708 3.142 1.5708" xyz="0.25470 0 0.13550"/></xacro:camera_mount>
    <xacro:camera_mount prefix="LEFT" parent="CHASSIS"><origin rpy="1.5708 3.142 3.142" xyz="0 0.17850 0.04450"/></xacro:camera_mount>
    <xacro:camera_mount prefix="RIGHT" parent="CHASSIS"><origin rpy="1.5708 -3.142 0" xyz="0 -0.17850 0.04450"/></xacro:camera_mount>
    <xacro:camera_mount prefix="BACK" parent="CHASSIS"><origin rpy="1.5708 3.142 -1.5708" xyz="-0.35670 0 0.094"/></xacro:camera_mount>

    <!-- MAIN TRACK SYSTEM -->
    <link name="R_TRACK_WHEEL1">
      <inertial>
        <mass value="2.23528"/>
        <inertia ixx="0.00367" iyy="0.00659" izz="0.00367" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
      </collision>
    </link>
    <joint name="R_TRACK_WHEEL1" type="continuous">
      <parent link="CHASSIS"/>
      <child link="R_TRACK_WHEEL1"/>
      <origin rpy="0 0 0" xyz="0.234 -0.146 0.062"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="R_TRACK_WHEEL2">
      <inertial>
        <mass value="2.23528"/>
        <inertia ixx="0.00367" iyy="0.00659" izz="0.00367" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
      </collision>
    </link>
    <joint name="R_TRACK_WHEEL2" type="continuous">
      <parent link="CHASSIS"/>
      <child link="R_TRACK_WHEEL2"/>
      <origin rpy="0 0 0" xyz="-0.234 -0.146 0.062"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="R_TRACK_BOTTOM_GUIDE">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <collision>
        <geometry>
          <box size="0.306 0.067 0.050125"/>
        </geometry>
      </collision>
    </link>
    <joint name="R_TRACK_BOTTOM_GUIDE" type="fixed">
      <parent link="CHASSIS"/>
      <child link="R_TRACK_BOTTOM_GUIDE"/>
      <origin rpy="0 0 0" xyz="0.00050 -0.14150 0.00105"/>
    </joint>

    <link name="R_TRACK_TOP_ROLLER">
      <inertial>
        <mass value="0.08514"/>
        <inertia ixx="0.0000186" ixy="0" ixz="0" iyy="0.0000097" iyz="0" izz="0.0000186"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.01516"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.01516"/>
        </geometry>
      </collision>
    </link>
    <joint name="R_TRACK_TOP_ROLLER" type="fixed">
      <parent link="CHASSIS"/>
      <child link="R_TRACK_TOP_ROLLER"/>
      <origin rpy="0 0 0" xyz="0 -0.133 0.151"/>
    </joint>

    <link name="L_TRACK_WHEEL1">
      <inertial>
        <mass value="2.23528"/>
        <inertia ixx="0.00367" iyy="0.00659" izz="0.00367" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 -0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 -0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
      </collision>
    </link>
    <joint name="L_TRACK_WHEEL1" type="continuous">
      <parent link="CHASSIS"/>
      <child link="L_TRACK_WHEEL1"/>
      <origin rpy="0 0 0" xyz="0.234 0.146 0.062"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="L_TRACK_WHEEL2">
      <inertial>
        <mass value="2.23528"/>
        <inertia ixx="0.00367" iyy="0.00659" izz="0.00367" ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 -0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 -0.02025 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.07681"/>
        </geometry>
      </collision>
    </link>
    <joint name="L_TRACK_WHEEL2" type="continuous">
      <parent link="CHASSIS"/>
      <child link="L_TRACK_WHEEL2"/>
      <origin rpy="0 0 0" xyz="-0.234 0.146 0.062"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="L_TRACK_BOTTOM_GUIDE">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
      <collision>
        <geometry>
          <box size="0.306 0.067 0.050125"/>
        </geometry>
      </collision>
    </link>
    <joint name="L_TRACK_BOTTOM_GUIDE" type="fixed">
      <parent link="CHASSIS"/>
      <child link="L_TRACK_BOTTOM_GUIDE"/>
      <origin rpy="0 0 0" xyz="0.00050 0.14150 0.00105"/>
    </joint>

    <link name="L_TRACK_TOP_ROLLER">
      <inertial>
        <mass value="0.08514"/>
        <inertia ixx="0.0000186" ixy="0" ixz="0" iyy="0.0000097" iyz="0" izz="0.0000186"/>
      </inertial>
      <visual>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.01516"/>
        </geometry>
        <material name="LIGHT_YELLOW"/>
      </visual>
      <collision>
        <origin rpy="-1.5708 0 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.044" radius="0.01516"/>
        </geometry>
      </collision>
    </link>
    <joint name="L_TRACK_TOP_ROLLER" type="fixed">
      <parent link="CHASSIS"/>
      <child link="L_TRACK_TOP_ROLLER"/>
      <origin rpy="0 0 0" xyz="0 0.133 0.151"/>
