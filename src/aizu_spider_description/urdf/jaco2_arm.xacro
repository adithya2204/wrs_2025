    <joint name="${prefix}FINGER3_TIP" type="fixed">
      <parent link="${prefix}FINGER3"/>
      <child link="${prefix}FINGER3_TIP"/>
      <origin xyz="-0.003 0 0.044" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
